#ifndef MERIDIAN_MOON
#define MERIDIAN_MOON

// The Moon as a lit sphere textured with NASA's CGI Moon Kit (SVS 4720): LRO LROC WAC colour
// (2025 16-bit release) and normals from LOLA elevation (ldem_64), both prepared by
// tools/prep_moon.py. Only the near side is stored (longitude -100..+100 degrees; the Moon is
// tidally locked, libration shows at most ~8 degrees beyond the limb). Each texture is a mip atlas:
// the full-resolution map on the left, successively halved levels stacked in a column on the
// right, because Iris does not build mipmaps for custom textures and the small disk would
// otherwise shimmer.
//
// Shading: Lommel-Seeliger lunar reflectance with an opposition surge, lit by the real sun
// direction, plus earthshine on the night side.

uniform sampler2D moonAlbedo;
uniform sampler2D moonNormal;

// Generated by tools/prep_moon.py: MOON_TEX_W, MOON_TEX_H (base level), MOON_LON_SPAN.
#include "/lib/sky/moon_dims.glsl"

vec2 moonAtlasUv(vec2 uv, float lod, out float levelScale) {
    // Level 0 occupies x in [0, W), levels >= 1 the column x in [W, 1.5 W).
    float level = clamp(floor(lod), 0.0, 8.0);
    float s = exp2(-level);
    levelScale = s;
    vec2 size = vec2(MOON_TEX_W, MOON_TEX_H) * s;
    vec2 origin = level < 0.5 ? vec2(0.0) : vec2(MOON_TEX_W, MOON_TEX_H * (1.0 - 2.0 * s));
    vec2 texel = clamp(uv * size, vec2(0.5), size - 0.5);
    return (origin + texel) / vec2(MOON_TEX_W * 1.5, MOON_TEX_H);
}

vec4 sampleMoonAtlas(sampler2D tex, vec2 uv, float lod) {
    float s0, s1;
    vec4 a = texture(tex, moonAtlasUv(uv, lod, s0));
    vec4 b = texture(tex, moonAtlasUv(uv, lod + 1.0, s1));
    return mix(a, b, fract(max(lod, 0.0)));
}

// Radiance of the Moon disk along `dir` (player space), or 0 outside it. `sunDir` lights it,
// `fullIllum` the full-Moon illuminance (SkyLights.moonFullIllum), `pixelAngle` the pixel size.
vec3 moonDiskRadiance(vec3 dir, vec3 moonDir, vec3 sunDir, vec3 axis, vec3 fullIllum, float pixelAngle, out float coverage) {
    coverage = 0.0;
    float c = dot(dir, moonDir);
    float ang = acos(clamp(c, -1.0, 1.0));
    if (ang > MOON_ANGULAR_RADIUS * 1.15) return vec3(0.0);

    // Moon-centred frame: forward = towards the observer, up = celestial axis projected.
    vec3 f = -moonDir;
    vec3 r = normalize(cross(axis, f));
    vec3 u = cross(f, r);
    // Position on the disk in units of the Moon's radius.
    vec3 d = dir - moonDir * c;
    vec2 disk = vec2(dot(d, -r), dot(d, u)) / sin(MOON_ANGULAR_RADIUS);
    float rr = dot(disk, disk);
    // Anti-aliased limb.
    float edge = (1.0 - sqrt(rr)) * sin(MOON_ANGULAR_RADIUS) / max(pixelAngle, 1e-5);
    coverage = saturate(edge + 0.5);
    if (coverage <= 0.0) return vec3(0.0);
    vec3 nLocal = vec3(disk, sqrt(max(1.0 - rr, 0.0)));          // x east-ish, y north, z to viewer
    vec3 n = normalize(-r * nLocal.x + u * nLocal.y + f * nLocal.z);

    // Selenographic coordinates: the near side faces the observer.
    float lon = atan(nLocal.x, nLocal.z);
    float lat = asin(clamp(nLocal.y, -1.0, 1.0));
    vec2 uv = vec2(lon / radians(MOON_LON_SPAN) + 0.5, 0.5 - lat / PI);

    // Texture LOD from the footprint of one pixel on the map.
    float texelsPerRadian = MOON_TEX_W / radians(MOON_LON_SPAN);
    float footprint = pixelAngle / sin(MOON_ANGULAR_RADIUS) / max(nLocal.z, 0.15);
    float lod = log2(max(footprint * texelsPerRadian, 1.0));

    vec3 albedo = srgbToLinear(sampleMoonAtlas(moonAlbedo, uv, lod).rgb);
    vec3 nm = sampleMoonAtlas(moonNormal, uv, lod).xyz * 2.0 - 1.0;
    // Normal map is in the local east/north/up frame of the sphere point.
    vec3 east = normalize(cross(u, n) + 1e-5);
    vec3 north = cross(n, east);
    vec3 ns = normalize(east * nm.x + north * nm.y + n * max(nm.z, 0.2));

    // Lommel-Seeliger with an opposition surge (Hapke-style shadow hiding near full moon).
    float mu0 = dot(ns, sunDir);
    float mu = max(dot(ns, f), 0.0);
    float phase = acos(clamp(dot(sunDir, f), -1.0, 1.0));
    float surge = 1.0 + 0.6 * exp(-phase / 0.12);
    float ls = mu0 > 0.0 ? mu0 / (mu0 + mu) : 0.0;
    // Normalised so the full Moon's disk-integrated illuminance equals `fullIllum` (the disk
    // average of ls * surge * 2 at full phase is 1.6 for the map's mean albedo of 0.12).
    vec3 sunlit = albedo / 0.12 * ls * surge * 2.0;
    #ifdef EARTHSHINE
    // Earthshine: Earth's phase seen from the Moon is the complement of the Moon's; it is
    // strongest at a thin crescent. Lifted ~10x above physical so it reads at night exposure.
    float earthFull = 0.5 * (1.0 - cos(PI - phase));
    sunlit += albedo / 0.12 * saturate(dot(n, f) * 0.8 + 0.2) * earthFull * 2.5e-3 * (mu0 > 0.0 ? 0.0 : 1.0);
    #endif
    vec3 rad = sunlit * fullIllum / (1.6 * PI * sq(MOON_ANGULAR_RADIUS));
    #ifdef MERIDIAN_STATE
    // Local adaptation for the disk only: at a moonlit-landscape exposure the real Moon is ~1000x
    // over-exposed (as in photographs), yet the eye sees its maria and craters because the retina
    // adapts locally. The disk's radiance is therefore limited so its brightest part lands about
    // 2.5x above display white at the current exposure; moonlight on the world stays physical.
    float peak = luminance(fullIllum) / (PI * sq(MOON_ANGULAR_RADIUS)) * 1.3;
    rad *= min(1.0, 2.5 / max(peak * state.exposure, 1e-6));
    #endif
    return rad * coverage;
}

#endif
