#ifndef MERIDIAN_STARS
#define MERIDIAN_STARS

// Point stars from real data (tools/prep_stars.py): the Yale Bright Star Catalogue for V <= 6.5
// and fainter stars measured from NASA SVS Deep Star Maps 2020 (hiptyc_2020_16k), calibrated to
// V magnitudes. Each star is a J2000 direction, a flux relative to the full Moon and a colour
// (B-V temperature for catalogue stars). Stars are binned into an
// octahedral grid of cells so a pixel only tests the stars of its own cell (stars near a cell
// border are stored in both cells). Each star is drawn as a small Gaussian matched to the pixel
// footprint, so it stays the same brightness and position under motion, resolution and zoom.
//
// The Milky Way background is milkyway_2020_4k (same dataset, bright stars removed), in full-Moon
// illuminance units per steradian, calibrated to observed surface brightness.

uniform usampler2D starCells;   // RG16UI: x first star index, y count
uniform sampler2D starData;     // RGBA32F, 2 texels per star: (dir.xyz, flux), (rgb, 0)
uniform sampler2D milkyWay;     // RGBA8, log-encoded linear radiance, plate carree, RA 0h centre

const int STAR_CELL_RES = 256;
const int STAR_DATA_WIDTH = 1024;
// Generated by tools/prep_stars.py: MILKY_WAY_ENCODE_K, MILKY_WAY_MAX.
#include "/lib/sky/stars_dims.glsl"

vec2 starOctUv(vec3 d) {
    d /= abs(d.x) + abs(d.y) + abs(d.z);
    vec2 p = d.xy;
    if (d.z < 0.0) p = (1.0 - abs(p.yx)) * vec2(p.x >= 0.0 ? 1.0 : -1.0, p.y >= 0.0 ? 1.0 : -1.0);
    return p * 0.5 + 0.5;
}

// Radiance of catalogue stars along equatorial direction `eq`; `pixelAngle` is the angular size
// of one pixel in radians.
vec3 starRadiance(vec3 eq, float pixelAngle) {
    ivec2 cell = clamp(ivec2(starOctUv(eq) * float(STAR_CELL_RES)), ivec2(0), ivec2(STAR_CELL_RES - 1));
    uvec2 range = texelFetch(starCells, cell, 0).xy;
    vec3 sum = vec3(0.0);
    float sigma = max(pixelAngle * 0.55, 1.2e-4);
    float inv2s2 = 0.5 / (sigma * sigma);
    float norm = 1.0 / (TAU * sigma * sigma);
    for (uint i = 0u; i < 24u; i++) {
        if (i >= range.y) break;
        int idx = int(range.x + i) * 2;
        ivec2 t0 = ivec2(idx % STAR_DATA_WIDTH, idx / STAR_DATA_WIDTH);
        vec4 a = texelFetch(starData, t0, 0);
        vec4 b = texelFetch(starData, t0 + ivec2(1, 0), 0);
        vec3 dv = eq - a.xyz;
        float r2 = dot(dv, dv);
        sum += b.rgb * (a.w * norm * exp(-r2 * inv2s2));
    }
    return sum;
}

vec3 milkyWayRadiance(vec3 eq) {
    // Plate carree: u = 0.5 - RA / 2pi (RA increases to the left), v = 0.5 - Dec / pi.
    float ra = atan(eq.y, eq.x);
    float dec = asin(clamp(eq.z, -1.0, 1.0));
    vec2 uv = vec2(0.5 - ra / TAU, 0.5 - dec / PI);
    uv.x = fract(uv.x);
    vec3 e = texture(milkyWay, uv).rgb;
    return (exp2(e * log2(1.0 + MILKY_WAY_ENCODE_K)) - 1.0) / MILKY_WAY_ENCODE_K * MILKY_WAY_MAX;
}

#endif
