profile=Quality Preset
profile.comment=Low and Medium favour frame rate; High is the intended experience; Ultra and Cinematic raise sample counts, resolutions and simulation size for powerful GPUs and screenshots.
profile.LOW=Low
profile.MEDIUM=Medium
profile.HIGH=High
profile.ULTRA=Ultra
profile.CINEMATIC=Cinematic
screen.LIGHTING=Lighting
screen.SHADOWS=Shadows
screen.MATERIALS=Materials and LabPBR
screen.ATMOSPHERE=Atmosphere
screen.MOON=Moon
screen.ECLIPSES=Eclipses
screen.END=End Black Hole
screen.NETHER=Nether Effects
screen.CAMERA=Camera and Exposure
screen.POST=Post-Processing
screen.COLOR=Colour Profile and Custom Colour
option.COLOR_PROFILE=Colour Profile
option.COLOR_PROFILE.comment=Natural: photographic. Vibrant: rich, luminous colour (default). Cinematic: strong warm/cool separation and contrast. Fantasy: stylised skies, light and auroras. Custom: uses the settings on the Colour screen.
value.COLOR_PROFILE.0=Natural
value.COLOR_PROFILE.1=Vibrant
value.COLOR_PROFILE.2=Cinematic
value.COLOR_PROFILE.3=Fantasy
value.COLOR_PROFILE.4=Custom
option.SUN_WARMTH=Sun Warmth (Custom)
option.SUN_WARMTH.comment=Shifts the sun's colour temperature toward gold. Applied to the sunlight itself, so sky, clouds and terrain stay consistent. Only used by the Custom profile.
option.SKY_LIGHT_TINT=Sky Light Tint (Custom)
option.SKY_LIGHT_TINT.comment=Tints light from the sky dome (what lights shaded areas) toward blue. Only used by the Custom profile.
option.SHADOW_COLOR_INFLUENCE=Shadow Colour (Custom)
option.SHADOW_COLOR_INFLUENCE.comment=Colour separation between sunlit and shaded surfaces. Only used by the Custom profile.
option.COLORED_LIGHT_INTENSITY=Block Light Strength (Custom)
option.COLORED_LIGHT_INTENSITY.comment=Brightness of block and held light. Only used by the Custom profile.
option.COLORED_LIGHT_SATURATION=Block Light Colour (Custom)
option.COLORED_LIGHT_SATURATION.comment=Saturation of coloured block light. Only used by the Custom profile.
option.INDIRECT_SATURATION=Bounce Light Colour (Custom)
option.INDIRECT_SATURATION.comment=Saturation of screen-space bounce light. Only used by the Custom profile.
option.REFLECTION_INTENSITY=Reflection Strength (Custom)
option.REFLECTION_INTENSITY.comment=Scales sky and screen-space reflections (water reflectance is capped at 100 %). Only used by the Custom profile.
option.WATER_COLOR_RESPONSE=Water Colour (Custom)
option.WATER_COLOR_RESPONSE.comment=Strength of water's own scattered colour (turquoise shallows, blue depths). Absorption is unchanged. Only used by the Custom profile.
option.CLOUD_LIGHT_INTENSITY=Cloud Lighting (Custom)
option.CLOUD_LIGHT_INTENSITY.comment=Sunlight reaching the clouds. Only used by the Custom profile.
option.TONEMAP=Tone Curve (Custom)
option.TONEMAP.comment=Filmic: balanced. Cinematic: deeper shadows. Neutral: keeps bright colours saturated. Only used by the Custom profile.
value.TONEMAP.0=Filmic
value.TONEMAP.1=Cinematic
value.TONEMAP.2=Neutral
option.SSGI=Bounce Light (SSGI)
option.SSGI.comment=Screen-space global illumination: light bounces off nearby lit and glowing surfaces and takes their colour. Only surfaces visible on screen contribute.
option.SSGI_RAYS=Bounce Light Rays
option.SSGI_RAYS.comment=Rays per half-resolution pixel. More rays reduce noise before temporal filtering.
option.SSGI_STEPS=Bounce Light Steps
option.SSGI_STEPS.comment=Steps per ray.
option.SSGI_RADIUS=Bounce Light Reach
option.SSGI_RADIUS.comment=How far (in blocks) bounce light is gathered from.
option.SSGI_STRENGTH=Bounce Light Strength
option.SSGI_STRENGTH.comment=Scales indirect light. 1 is energy-consistent.
option.SSGI_TEMPORAL=Bounce Light Responsiveness
option.SSGI_TEMPORAL.comment=Fraction of each new frame blended into the accumulated result. Lower is smoother, higher reacts faster.
option.HAND_LIGHT=Coloured Held Light
option.HAND_LIGHT.comment=Torches, lanterns, soul torches and other light items in your hands light the world in their own colour.
option.BLOCK_LIGHT_SPECULAR=Block Light Highlights
option.BLOCK_LIGHT_SPECULAR.comment=Torches, lava and lamps produce reflections and highlights on smooth, wet and metal surfaces.
option.LOD_SHADOWS=Distant Horizons Shadows
option.LOD_SHADOWS.comment=Untested: renders DH terrain into the shadow map so LOD mountains inside the shadow distance cast shadows.
value.DEBUG_VIEW.21=Bounce Light (SSGI)
value.DEBUG_VIEW.22=Lightmap (block red, sky blue)
value.DEBUG_VIEW.23=Bloom Contribution
value.DEBUG_VIEW.24=Before Tone Mapping (magenta > 4x white)
option.BLOOM=Bloom
option.BLOOM.comment=Soft glow around bright lights. Energy conserving: it spreads light rather than adding it.
option.BLOOM_STRENGTH=Bloom Strength
option.BLOOM_STRENGTH.comment=Fraction of the image redistributed into the glow.
option.BLOOM_RADIUS=Bloom Radius
option.BLOOM_RADIUS.comment=How strongly the wider (blurrier) levels of the glow contribute.
option.DOF=Depth of Field
option.DOF.comment=Blurs what is out of focus like a camera lens.
option.DOF_FOCUS=Focus Distance
option.DOF_FOCUS.comment=Auto focuses on what is at the centre of the screen; otherwise a fixed distance in blocks.
value.DOF_FOCUS.0=Auto
option.DOF_APERTURE=Aperture
option.DOF_APERTURE.comment=Lens aperture. Larger values give a shallower depth of field.
option.DOF_MAX_RADIUS=Maximum Blur
option.DOF_MAX_RADIUS.comment=Largest blur radius in pixels.
option.DOF_SAMPLES=Depth of Field Quality
option.DOF_SAMPLES.comment=Samples per pixel for the lens blur.
option.MOTION_BLUR=Motion Blur
option.MOTION_BLUR.comment=Blur from camera movement. The held item is never blurred.
option.MOTION_BLUR_STRENGTH=Shutter
option.MOTION_BLUR_STRENGTH.comment=Fraction of a frame the virtual shutter is open.
option.WHITE_BALANCE=White Balance
option.WHITE_BALANCE.comment=Colour temperature the camera treats as white. Lower is cooler, higher is warmer.
option.CONTRAST=Contrast
option.CONTRAST.comment=Contrast around middle grey.
option.SATURATION=Saturation
option.SATURATION.comment=Overall colour saturation.
option.VIBRANCE=Vibrance
option.VIBRANCE.comment=Boosts muted colours more than already saturated ones.
option.NIGHT_DESATURATION=Night Vision Shift
option.NIGHT_DESATURATION.comment=In very dim light colours fade and shift toward blue, as with real night vision.
option.VIGNETTE=Vignette
option.VIGNETTE.comment=Darkens the image corners.
option.VIGNETTE_STRENGTH=Vignette Strength
option.VIGNETTE_STRENGTH.comment=How dark the corners become.
option.SHARPENING=Sharpening
option.SHARPENING.comment=Contrast-adaptive sharpening to restore detail softened by TAA. 0 disables it.
screen.DEBUG=Debugging

# ---------------------------------------------------------------- lighting
option.BLOCKLIGHT_TEMPERATURE=Block Light Temperature
option.BLOCKLIGHT_TEMPERATURE.comment=Colour temperature (Kelvin) of light from the vanilla block lightmap. Lower is warmer.
option.BLOCKLIGHT_INTENSITY=Block Light Intensity
option.BLOCKLIGHT_INTENSITY.comment=Brightness of torches, lamps and other light sources on nearby surfaces.
option.EMISSION_INTENSITY=Emissive Brightness
option.EMISSION_INTENSITY.comment=Brightness of glowing surfaces themselves (lava, lamp faces, LabPBR emission).
option.SKYLIGHT_INTENSITY=Sky Light Intensity
option.SKYLIGHT_INTENSITY.comment=Scales the ambient light coming from the sky dome.
option.AMBIENT_FLOOR=Minimum Ambient Light
option.AMBIENT_FLOOR.comment=Tiny base light so the darkest caves are not pure black. 0 = physically dark.
option.SUBSURFACE_SCATTERING=Subsurface Scattering
option.SUBSURFACE_SCATTERING.comment=Light passing through leaves, grass and LabPBR subsurface materials.

# ---------------------------------------------------------------- shadows
option.shadowMapResolution=Shadow Resolution
option.shadowMapResolution.comment=Size of the shadow map. Higher is sharper and more expensive in VRAM and rendering time.
option.shadowDistance=Shadow Distance
option.shadowDistance.comment=How far (in blocks) real shadows reach. Beyond it, shadows are estimated from sky light.
option.SHADOW_FILTER=Shadow Filtering
option.SHADOW_FILTER.comment=Hard is fastest. PCF softens edges. Variable penumbra makes shadows sharp at contact and softer further from the caster.
value.SHADOW_FILTER.0=Hard
value.SHADOW_FILTER.1=PCF (8 samples)
value.SHADOW_FILTER.2=PCF (16 samples)
value.SHADOW_FILTER.3=Variable Penumbra (16)
value.SHADOW_FILTER.4=Variable Penumbra (32)
option.SHADOW_SOFTNESS=Shadow Softness
option.SHADOW_SOFTNESS.comment=Scales the shadow blur radius.
option.SHADOW_DISTORTION=Shadow Detail Focus
option.SHADOW_DISTORTION.comment=Lower values concentrate shadow resolution closer to the player at the cost of distant shadows.
option.COLORED_SHADOWS=Coloured Shadows
option.COLORED_SHADOWS.comment=Light passing through stained glass and other translucent blocks takes their colour.

# ---------------------------------------------------------------- materials
option.NORMAL_MAPPING=Normal Maps
option.NORMAL_MAPPING.comment=Use resource-pack normal maps (LabPBR _n textures).
option.SPECULAR_MAPPING=Specular Maps
option.SPECULAR_MAPPING.comment=Use resource-pack specular maps (LabPBR _s textures). Without them, sensible defaults are used.
option.VANILLA_METALS=Vanilla Metals
option.WAVING_PLANTS=Waving Plants
option.WAVING_PLANTS.comment=Grass, flowers, crops, seagrass and leaves sway in the wind (stronger in storms). Shadows move with them.
option.WAVING_STRENGTH=Wind Strength
option.WAVING_STRENGTH.comment=Amplitude of plant sway.
option.PARALLAX=Parallax Occlusion
option.PARALLAX.comment=Real depth for textures with height maps (LabPBR _n alpha). No effect without a PBR resource pack.
option.PARALLAX_DEPTH=Parallax Depth
option.PARALLAX_DEPTH.comment=Scales the LabPBR height range (full range = a quarter of the texture's width).
option.PARALLAX_SAMPLES=Parallax Quality
option.PARALLAX_SAMPLES.comment=Height steps traced per pixel.
option.PARALLAX_DISTANCE=Parallax Distance
option.PARALLAX_DISTANCE.comment=Distance in blocks up to which parallax is applied.
option.VANILLA_METALS.comment=Without a PBR resource pack, iron, gold, copper and netherite blocks reflect like metal.

screen.REFLECTIONS=Reflections
screen.GI=Indirect Light and Occlusion
option.COLORED_LIGHTING=Coloured Block Light
option.COLORED_LIGHTING.comment=Light from lava, soul fire, redstone, amethyst and other sources tints its surroundings. Uses a 128x64x128 light volume (16 MB) around you; brightness still follows vanilla light levels, so it cannot leak through walls.
option.SSAO=Ambient Occlusion
option.SSAO.comment=Screen-space ambient occlusion darkens creases, corners and the ground under small objects.
option.SSAO_SAMPLES=Ambient Occlusion Quality
option.SSAO_SAMPLES.comment=Samples per pixel for ambient occlusion.
option.SSAO_STRENGTH=Ambient Occlusion Strength
option.SSAO_STRENGTH.comment=How dark occluded areas become.
option.CONTACT_SHADOWS=Contact Shadows
option.CONTACT_SHADOWS.comment=Short screen-space shadows for small details the shadow map is too coarse to show.
option.OPAQUE_SSR=Block Reflections
option.OPAQUE_SSR.comment=Screen-space reflections on smooth blocks, metals and wet surfaces. Rough surfaces reflect blurrily.
option.SSR_MIN_SMOOTHNESS=Reflection Threshold
option.SSR_MIN_SMOOTHNESS.comment=Minimum smoothness for a surface to use traced reflections. Rougher surfaces reflect the sky only.
screen.WATER=Water
screen.WATER_SIM=Water Simulation
option.SSR_STEPS=Reflection Quality
option.SSR_STEPS.comment=Number of screen-space steps traced per reflection. More steps catch thinner objects and longer reflections.
option.WATER_STYLE=Water Type
option.WATER_STYLE.comment=Optical character of water: how quickly it absorbs light and how much it scatters.
value.WATER_STYLE.0=Clear Ocean
value.WATER_STYLE.1=Coastal
value.WATER_STYLE.2=Tropical
value.WATER_STYLE.3=Murky Lake
option.WATER_DENSITY=Water Murkiness
option.WATER_DENSITY.comment=Scales absorption and scattering. Higher values hide deep water sooner.
option.WATER_REFRACTION=Refraction Strength
option.WATER_REFRACTION.comment=How strongly waves bend the view of what is under the surface.
option.WATER_REFLECTIVITY=Water Reflectivity
option.WATER_REFLECTIVITY.comment=Scales the physically based (Fresnel) reflection.
option.WATER_CAUSTICS=Caustics
option.WATER_CAUSTICS.comment=Strength of the focused light patterns on underwater surfaces, computed from the actual waves.
option.WATER_WAVE_COUNT=Wave Detail
option.WATER_WAVE_COUNT.comment=Number of wave components summed for the water surface.
option.WATER_WAVE_HEIGHT=Wave Height
option.WATER_WAVE_HEIGHT.comment=Steepness of all waves. Oceans are rougher than rivers and enclosed lakes.
option.WATER_WAVE_SPEED=Wave Speed
option.WATER_WAVE_SPEED.comment=Multiplies the physical wave speed.
option.WATER_WIND_SPEED=Wind Speed
option.WATER_WIND_SPEED.comment=Fair-weather wind in m/s. Stronger wind makes longer, larger waves; storms raise it further.
option.WATER_WIND_ANGLE=Wind Direction
option.WATER_WIND_ANGLE.comment=Direction the wind blows from, in degrees.
option.WATER_SIMULATION=Interactive Water
option.WATER_SIMULATION.comment=GPU simulation of ripples from swimming, splashes and boat wakes around you. Only you and your boat disturb the water; other entities are not visible to shaders.
option.WATER_SIM_RES=Simulation Resolution
option.WATER_SIM_RES.comment=Grid size of the simulation. Covered area = resolution / cells per block (default 64 blocks across). 2048 uses 64 MB of VRAM.
option.WATER_SIM_CPB=Simulation Detail
option.WATER_SIM_CPB.comment=Simulation cells per block. Higher values give finer ripples over a smaller area.
option.WATER_SIM_WAVE_SPEED=Ripple Speed
option.WATER_SIM_WAVE_SPEED.comment=Propagation speed of simulated ripples in blocks per second (limited automatically for stability).
option.WATER_SIM_STRENGTH=Simulation Strength
option.WATER_SIM_STRENGTH.comment=Overall strength of all simulated disturbances.
option.PLAYER_RIPPLE_STRENGTH=Player Ripples
option.PLAYER_RIPPLE_STRENGTH.comment=Strength of ripples and splashes from the player.
option.BOAT_WAKE_STRENGTH=Boat Wakes
option.BOAT_WAKE_STRENGTH.comment=Strength of the wake and bobbing of the boat you ride.

screen.CLOUDS=Volumetric Clouds
option.VOLUMETRIC_CLOUDS=Volumetric Clouds
option.VOLUMETRIC_CLOUDS.comment=Raymarched 3-D clouds with real volume, self-shadowing and weather. You can fly into them.
option.CLOUD_QUALITY=Cloud Quality
option.CLOUD_QUALITY.comment=Raymarch and light-march sample counts. Cinematic is meant for screenshots.
value.CLOUD_QUALITY.0=Low
value.CLOUD_QUALITY.1=Medium
value.CLOUD_QUALITY.2=High
value.CLOUD_QUALITY.3=Ultra
value.CLOUD_QUALITY.4=Cinematic
option.CLOUD_RES=Cloud Resolution
option.CLOUD_RES.comment=Fraction of screen resolution the clouds are traced at before temporal reconstruction.
option.CLOUD_COVERAGE=Cloud Coverage
option.CLOUD_COVERAGE.comment=Fair-weather sky cover. Rain and storms raise it automatically.
option.CLOUD_DAILY_VARIATION=Daily Variation
option.CLOUD_DAILY_VARIATION.comment=How much the cloud cover changes from one day to the next.
option.CLOUD_DENSITY=Cloud Density
option.CLOUD_DENSITY.comment=Optical thickness of the clouds. Denser clouds have darker bases.
option.CLOUD_TYPE_BIAS=Cloud Type
option.CLOUD_TYPE_BIAS.comment=Negative favours flat stratus layers, positive favours tall cumulus.
option.CLOUD_ALTITUDE=Cloud Base Height
option.CLOUD_ALTITUDE.comment=Altitude of the cloud base in blocks.
option.CLOUD_WIND_SPEED=Cloud Wind Speed
option.CLOUD_WIND_SPEED.comment=How fast clouds drift, in blocks per second (doubles in storms). Uses the water wind direction.
option.CLOUD_MAX_DISTANCE=Cloud Draw Distance
option.CLOUD_MAX_DISTANCE.comment=Farthest distance at which clouds are traced, in blocks.
option.CLOUD_SHADOWS=Cloud Shadows
option.CLOUD_SHADOWS.comment=Clouds cast moving shadows on the ground and water.
option.CLOUD_SHADOW_RES=Cloud Shadow Resolution
option.CLOUD_SHADOW_RES.comment=Resolution of the cloud shadow map.
option.CLOUD_SHADOW_RANGE=Cloud Shadow Range
option.CLOUD_SHADOW_RANGE.comment=Area covered by the cloud shadow map, in blocks.
option.CIRRUS_AMOUNT=Cirrus Clouds
option.CIRRUS_AMOUNT.comment=Amount of thin, streaky high-altitude ice clouds.

screen.WEATHER=Weather
screen.VOLUMETRICS=Volumetric Light
screen.AURORA=Auroras
option.WETNESS=Wet Surfaces
option.WETNESS.comment=Rain wets everything it reaches. Porous blocks darken; smooth ones get a reflective film.
option.PUDDLES=Puddles
option.PUDDLES.comment=Puddles form on flat open ground while it rains and dry up afterwards.
option.PUDDLE_AMOUNT=Puddle Amount
option.PUDDLE_AMOUNT.comment=How much flat ground puddles cover in heavy rain.
option.RAIN_RIPPLES=Rain Ripples
option.RAIN_RIPPLES.comment=Expanding rings from raindrops on puddles and water.
option.RAINBOW_BRIGHTNESS=Rainbows
option.RAINBOW_BRIGHTNESS.comment=Primary and secondary rainbows opposite a low sun while it rains. 0 disables them.
option.LIGHTNING_BRIGHTNESS=Lightning Flashes
option.LIGHTNING_BRIGHTNESS.comment=How strongly lightning lights the world and the clouds.
option.MORNING_FOG=Morning Mist
option.MORNING_FOG.comment=Low ground mist around sunrise, thicker in humid biomes.
option.WEATHER_FOG=Rain Haze
option.WEATHER_FOG.comment=Haze during rain and storms.
option.VOLUMETRIC_LIGHT=Volumetric Light
option.VOLUMETRIC_LIGHT.comment=Shadowed light shafts through mist, rain haze and under water.
option.VL_STEPS=Volumetric Light Quality
option.VL_STEPS.comment=Samples per pixel for light shafts (traced at half resolution).
option.VL_DISTANCE=Light Shaft Distance
option.VL_DISTANCE.comment=How far light shafts are traced in air, in blocks.
option.VL_WATER_DISTANCE=Underwater Shaft Distance
option.VL_WATER_DISTANCE.comment=How far light shafts are traced under water, in blocks.
option.VL_STRENGTH=Light Shaft Strength
option.VL_STRENGTH.comment=Scales the brightness of light shafts.
option.VOLUMETRIC_FOG_BASELINE=Clear-Weather Haze
option.VOLUMETRIC_FOG_BASELINE.comment=A faint haze that makes light shafts visible even in clear weather.
option.AURORA=Auroras
option.AURORA.comment=Auroras toward the north on some nights.
option.BE_AURORA_FREQUENCY=Aurora Frequency
option.BE_AURORA_FREQUENCY.comment=Chance that any given night has an aurora. 1 = every night.
option.AURORA_BRIGHTNESS=Aurora Brightness
option.AURORA_BRIGHTNESS.comment=Brightness of auroral curtains.
option.AURORA_SPEED=Aurora Motion
option.AURORA_SPEED.comment=How fast the curtains drift and their rays flicker.
option.AURORA_HIGH_EMISSION=Aurora Red/Violet
option.AURORA_HIGH_EMISSION.comment=Strength of the red high-altitude oxygen glow and the violet lower fringe relative to the green.
option.AURORA_STEPS=Aurora Quality
option.AURORA_STEPS.comment=Raymarch samples through the aurora layer.
option.HEAT_HAZE=Heat Haze
option.HEAT_HAZE.comment=Shimmering hot air in the Nether, stronger in the distance.
option.HEAT_HAZE_STRENGTH=Heat Haze Strength
option.HEAT_HAZE_STRENGTH.comment=Strength of the heat shimmer.

# ---------------------------------------------------------------- atmosphere
option.sunPathRotation=Sun Path Angle
option.sunPathRotation.comment=Tilts the sun's path across the sky, in degrees. Also tilts the moon's orbit and the star field.
option.BE_SUN_SIZE=Sun Size
option.BE_SUN_SIZE.comment=Apparent diameter of the sun in degrees. The real sun is 0.53.
option.AERIAL_PERSPECTIVE=Aerial Perspective
option.AERIAL_PERSPECTIVE.comment=How quickly distant terrain fades into the blue of the atmosphere. 0 disables it.

# ---------------------------------------------------------------- moon
option.MOON_TEXTURE=Moon Texture
option.MOON_TEXTURE.comment=NASA LRO moon map. 8K uses about 200 MB of VRAM and only helps when zoomed in (spyglass). Procedural uses no texture.
value.MOON_TEXTURE.0=Procedural
value.MOON_TEXTURE.1=2K
value.MOON_TEXTURE.2=4K
value.MOON_TEXTURE.3=8K
option.BE_MOON_SIZE=Moon Size
option.BE_MOON_SIZE.comment=Apparent diameter of the moon in degrees. If smaller than the sun, solar eclipses are annular.
option.MOON_BRIGHTNESS=Moon Brightness
option.MOON_BRIGHTNESS.comment=Brightness of the moon disk itself.
option.MOON_RELIEF=Moon Relief
option.MOON_RELIEF.comment=Strength of crater and mountain shading from NASA elevation data, strongest near the terminator.
option.MOON_SHARPNESS_BIAS=Moon Sharpness
option.MOON_SHARPNESS_BIAS.comment=Negative values sharpen the moon texture, positive values soften it.

# ---------------------------------------------------------------- eclipses
option.ECLIPSE_CYCLE_DAYS=Eclipse Cycle
option.ECLIPSE_CYCLE_DAYS.comment=Length in days of the moon's nodal cycle. Eclipse seasons happen twice per cycle, so shorter cycles mean more eclipses.
option.MOON_INCLINATION=Moon Orbit Tilt
option.MOON_INCLINATION.comment=Tilt of the moon's orbit in degrees. Smaller tilts make eclipses more frequent and longer.
option.ECLIPSE_SLOWDOWN=Eclipse Duration
option.ECLIPSE_SLOWDOWN.comment=Slows the moon near new and full moon so eclipses last minutes instead of seconds. 0 = uniform motion.
option.BE_ECLIPSE_PREVIEW=Eclipse Preview
option.BE_ECLIPSE_PREVIEW.comment=Debug: loops an eclipse every 60 seconds without changing world time. Solar previews need daytime, lunar previews need night.
value.BE_ECLIPSE_PREVIEW.0=Off
value.BE_ECLIPSE_PREVIEW.1=Partial Solar
value.BE_ECLIPSE_PREVIEW.2=Total Solar
value.BE_ECLIPSE_PREVIEW.3=Partial Lunar
value.BE_ECLIPSE_PREVIEW.4=Total Lunar

screen.NIGHT_SKY=Night Sky
option.MILKY_WAY_TEXTURE=NASA Milky Way
option.MILKY_WAY_TEXTURE.comment=Uses the Milky Way from NASA's Deep Star Maps 2020 (Gaia DR2, Hipparcos, Tycho): real star clouds, dust lanes and the Magellanic Clouds. Off: the procedural band.
option.NIGHT_SKY_BRIGHTNESS=Night Sky Brightness
option.NIGHT_SKY_BRIGHTNESS.comment=Brightens stars and the Milky Way together. Screens cannot show the real night sky's range and our exposure is limited, so 1 is physically scaled and 20 approximates dark-adapted eyes.
option.BE_STAR_DENSITY=Star Density
option.BE_STAR_DENSITY.comment=Number of procedural stars. 1 is close to the real naked-eye count.
option.STAR_TWINKLE=Star Twinkle
option.STAR_TWINKLE.comment=Atmospheric scintillation, stronger near the horizon.
option.MILKY_WAY_BRIGHTNESS=Milky Way Brightness
option.MILKY_WAY_BRIGHTNESS.comment=Brightness of the procedural galactic band and its dust lanes.

# ---------------------------------------------------------------- end / nether
option.END_BH_AZIMUTH=Black Hole Direction
option.END_BH_AZIMUTH.comment=Compass direction of the black hole in the End sky (degrees from north). Also the direction End shadows fall.
option.END_BH_ELEVATION=Black Hole Height
option.END_BH_ELEVATION.comment=Elevation of the black hole above the horizon, in degrees.
option.END_LIGHT_INTENSITY=End Light Intensity
option.END_LIGHT_INTENSITY.comment=Brightness of the light the accretion disk casts on the End.
option.END_FOG_DENSITY=End Fog Density
option.END_FOG_DENSITY.comment=Density of the dark haze over the End islands.
option.END_BLACK_HOLE=Black Hole
option.END_BLACK_HOLE.comment=A Schwarzschild black hole with a glowing accretion disk bends the End's starlight. Off shows plain deep space.
option.BH_QUALITY=Black Hole Quality
option.BH_QUALITY.comment=Performance: precomputed light paths, primary and secondary disk images. High: adds the third image (photon ring). Cinematic: traces every pixel's light path directly.
value.BH_QUALITY.0=Performance
value.BH_QUALITY.1=High
value.BH_QUALITY.2=Cinematic
option.BH_SIZE=Black Hole Size
option.BH_SIZE.comment=Apparent size of the black hole and its disk.
option.BH_DISK_TILT=Disk Tilt
option.BH_DISK_TILT.comment=How far the disk is tilted toward you, in degrees. Near 0 the disk is edge-on and lensing draws its far side over the hole.
option.BH_DISK_ROLL=Disk Roll
option.BH_DISK_ROLL.comment=Rotation of the disk around the line of sight, in degrees.
option.BH_DISK_OUTER=Disk Size
option.BH_DISK_OUTER.comment=Outer radius of the accretion disk in Schwarzschild radii. Its inner edge is the innermost stable orbit (3).
option.BH_DISK_TEMPERATURE=Disk Temperature
option.BH_DISK_TEMPERATURE.comment=Peak temperature of the disk in Kelvin; sets its colour.
option.BH_DISK_BRIGHTNESS=Disk Brightness
option.BH_DISK_BRIGHTNESS.comment=Brightness of the accretion disk.
option.BH_ROTATION_SPEED=Disk Rotation
option.BH_ROTATION_SPEED.comment=Speed of the swirling disk structure (inner parts orbit faster).
option.BH_DOPPLER=Doppler Beaming
option.BH_DOPPLER.comment=Relativistic beaming: the side of the disk moving toward you is brighter and bluer.
option.END_STAR_BRIGHTNESS=End Star Brightness
option.END_STAR_BRIGHTNESS.comment=Brightness of the stars behind the black hole.
option.END_NEBULA_BRIGHTNESS=Nebula Brightness
option.END_NEBULA_BRIGHTNESS.comment=Brightness of the faint nebulae and dust in the End sky.
option.END_PLANETS=Planets
option.END_PLANETS.comment=A ringed gas giant, a rocky world and an ice world orbit slowly across the End sky. They are lit by the accretion disk, so their phases change as they move.
option.END_BH_DRIFT=Black Hole Drift
option.END_BH_DRIFT.comment=The black hole wanders slowly (up to 18 degrees, one cycle per hour) around the set azimuth and elevation; the End's light and shadows follow.
option.NETHER_SMOKE=Nether Smoke
option.NETHER_SMOKE.comment=Gives the Nether haze slowly drifting smoke structure.
option.NETHER_BRIGHTNESS=Nether Brightness
option.NETHER_BRIGHTNESS.comment=Overall brightness of the Nether haze and ambient light.
option.NETHER_FOG_DENSITY=Nether Fog Density
option.NETHER_FOG_DENSITY.comment=How quickly the Nether fades into its coloured haze.

# ---------------------------------------------------------------- camera
option.AUTO_EXPOSURE=Auto Exposure
option.AUTO_EXPOSURE.comment=Adapt to scene brightness like an eye. When off, Fixed Exposure is used.
option.EXPOSURE_COMPENSATION=Exposure Compensation
option.EXPOSURE_COMPENSATION.comment=Shifts the final exposure in photographic stops (EV).
option.EXPOSURE_FIXED_EV=Fixed Exposure
option.EXPOSURE_FIXED_EV.comment=Exposure in stops used when Auto Exposure is off. Higher is brighter.
option.EXPOSURE_SPEED=Adaptation Speed
option.EXPOSURE_SPEED.comment=How fast the exposure adapts. Adapting to darkness is always slower than to brightness.
option.EXPOSURE_MIN_EV=Minimum Exposure
option.EXPOSURE_MIN_EV.comment=Darkest exposure auto exposure may choose (limits how much bright scenes are darkened).
option.EXPOSURE_MAX_EV=Maximum Exposure
option.EXPOSURE_MAX_EV.comment=Brightest exposure auto exposure may choose (limits how much dark scenes are brightened).
option.TAA=Temporal Anti-Aliasing
option.TAA.comment=Smooths edges and denoises soft shadows, clouds and reflections using previous frames.

